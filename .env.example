# ===== API Key 配置示例 =====
# 复制本文件为 .env（已被 .gitignore 排除，严禁提交）并填入真实 Key。
# 代码通过 os.getenv 读取，仓库内不保存任何密钥。

# DeepSeek API Key（本项目默认 LLM_PROVIDER=deepseek）
# 获取方式：登录 https://platform.deepseek.com → 首页「新建 API key」
DEEPSEEK_API_KEY=

# OpenAI API Key（当 LLM_PROVIDER 切换为 "openai" 时使用）
# 获取方式：登录 https://platform.openai.com → API keys → Create new secret key
OPENAI_API_KEY=
